# Internal API key for service-to-service authentication
INTERNAL_API_KEY=your-internal-api-key-here

# JWT signing secret for WebSocket authentication
JWT_SECRET=your-jwt-secret-here

# RBAC (M11) — hardcoded admin/viewer role pairs baked into JWT claims,
# not a persistent user store. Change before any real deployment.
ADMIN_CLIENT_ID=admin
ADMIN_CLIENT_SECRET=your-admin-secret-here
VIEWER_CLIENT_ID=viewer
VIEWER_CLIENT_SECRET=your-viewer-secret-here

# Which role pair the frontend container logs in as (defaults to viewer,
# a read-only dashboard). Set both to the ADMIN_CLIENT_ID/SECRET values
# above to demo the RBAC-gated AdminPanel (circuit-breaker reset button).
FRONTEND_CLIENT_ID=viewer
FRONTEND_CLIENT_SECRET=your-viewer-secret-here

# MLflow tracking token
MLFLOW_TRACKING_TOKEN=your-mlflow-token-here

# MLflow tracking server URI (used by aggregation-service)
MLFLOW_TRACKING_URI=http://mlflow:5000

# HTTP basic-auth credentials for mlflow-proxy (SEC-3) — the only way to
# reach MLflow's UI/API from the host/browser at http://localhost:5000.
# MLflow OSS itself has no auth, so this proxy is what actually protects it.
MLFLOW_PROXY_USER=admin
MLFLOW_PROXY_PASSWORD=your-mlflow-proxy-password-here

# RTSP source for ingest gateway.
# Set to a real RTSP stream URL to use the ingest-gateway.
# For local development without a camera, leave this blank and use
# simulate_stream.py or video_feeder.py instead (see README Quick Start).
RTSP_SOURCE=

# Upstream service URLs (must match aggregation-service/main.py var names)
VISION_URL=http://vision-service:8001/infer
RAG_URL=http://rag-agent:8002/audit

# Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# RAG agent: set to "false" to use real Ollama/Mistral (requires ollama service running)
MOCK_LLM=true

# Webhook fan-out targets for alert notifications (M9) — JSON array of
# {"url","token","format"} objects. format is "generic" or "slack".
# Example with the local demo receiver plus a real Slack incoming webhook:
# WEBHOOK_TARGETS=[{"url":"http://webhook-receiver:9000/webhook","format":"generic"},{"url":"https://hooks.slack.com/services/XXX/YYY/ZZZ","format":"slack"}]
WEBHOOK_TARGETS=[{"url":"http://webhook-receiver:9000/webhook","format":"generic"}]

# Kafka SASL credentials.
# Must match the broker JAAS config in docker-compose.yml (default: admin / admin-secret).
# Leaving these blank will cause SASL auth failures in ingest-gateway,
# aggregation-service, and temporal-service.
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=admin-secret

# Ollama/Mistral configuration
OLLAMA_MODEL=mistral:latest

# Path to the ResNext50+LSTM temporal model weights (WSL-3 fix: use stable local path).
# To download: python -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Naman712/Deep-fake-detection', filename='model_87_acc_20_frames_final_data.pt', local_dir='temporal-service/weights/')"
# Then set TEMPORAL_WEIGHTS_PATH=./temporal-service/weights/model_87_acc_20_frames_final_data.pt
# If unset, docker-compose falls back to the HuggingFace blob cache path (machine-specific).
TEMPORAL_WEIGHTS_PATH=